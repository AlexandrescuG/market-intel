[Unit]
Description=Тик торгового движка SBF

[Timer]
# Раз в час, со смещением на 3 минуты после круглого часа: к этому моменту
# sbf-mt5-pull уже долил свежий закрытый бар H1, а источники читают именно
# закрытые бары.
#
# 🔴 Частота НЕ выше часа осознанно. Урок gold_oil: вход раз в час при
# условии, живущем неделями, превратил один эпизод режима в 118 «сделок».
# Здесь от этого защищает dedup_key, но лишние тики всё равно ничего не
# добавляют — самый быстрый анализируемый ТФ у движка H1.
OnCalendar=*-*-* *:03:00
Persistent=false
AccuracySec=30s

[Install]
WantedBy=timers.target
