.env
*.env
# 🔴 Копии .env, которые оставляют после себя скрипты установки:
# .env.bak-20260901-111834, .env.overwritten-20260909-1544 и подобные.
# Правило `.env` ловит только файл ровно с этим именем, а `*.env` — то,
# что на .env ЗАКАНЧИВАЕТСЯ. Копии не подпадали ни под одно: 30.09.2026
# в рабочем каталоге лежали четыре штуки со 120 переменными суммарно, и
# любой `git add -A` отправил бы токены ботов, ключи брокера и почтовый
# пароль в историю навсегда. Сам .env в историю не попадал — проверено
# по всем коммитам.
.env.*
!.env.example
*.db
data/signals.db
*.session
data/browser_profile/
data/briefs/
data/reports/
data/baseline_reports/
data/observations.md
data/daily.log
data/monitor.log
*.log
__pycache__/
*.pyc
*.pyo
.venv/
.pytest_cache/
node_modules/
web/data/ohlc_*.json
# Картинка брифинга генерируется заново каждое утро (brief_image_job.py):
# в истории ей делать нечего, а 120 КБ в день превратили бы репозиторий
# в архив рассылки.
web/data/brief_image_*.png
# Снимок каталога брокера: 842 строки, переписывается каждые 15 секунд
# фоновым циклом. Данные, а не исходник.
web/data/broker_quotes.json
web/data/broker_catalog.json
web/data/broker_sparklines.json

# Локальные бэкапы и копии профиля браузера — содержат сессии и пароли
backups/
data/browser_profile.bak/
*.db-shm
*.db-wal

# Бандлы прогонов цикла — генерируются, как data/reports и data/briefs
data/cycle/

# Состояние антиспама надзора — рантайм, не код (SPEC_supervision_2026-08-26 §5)
data/ops_alert_state.json

# Состояние пульса: последний вердикт и когда о нём сообщили
# ({"key": "ИДУТ", "ts": …, "sent_ts": …}). Тот же рантайм, что и выше —
# сообщение шлётся при СМЕНЕ вердикта, и файл переписывается каждый
# прогон. Рядом leg_correlation.json остаётся в истории: он настройка,
# а не отметка времени.
data/engine/pulse_state.json

# Картинки к новостям: логотипы изданий и скриншоты твитов. Скачиваются
# задачей news_media_job и сборщиком твитов, восстанавливаются сами за
# двадцать минут. В репозитории им делать нечего — это чужие файлы,
# протухающий кэш и лишние мегабайты в истории.
web/media/
