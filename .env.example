# ── news_pipeline / Telethon (клиентский аккаунт «воровки») ───────────────────
# API_ID и API_HASH из my.telegram.org → App configuration
TELNEWS_API_ID=
TELNEWS_API_HASH=
# Путь к файлу сессии (без .session); при первом запуске Telethon попросит SMS-код
TELNEWS_SESSION=data/nevorovka_session
# Целевой канал для постинга (без @)
TELNEWS_TARGET=rostoklepestop
# Интервал между постами (сек)
POST_INTERVAL_SEC=45
# Окно дедупа кросс-источника (часы)
DEDUP_WINDOW_HOURS=6
# Пауза между ценовыми алертами (мин)
PRICE_COOLDOWN_MIN=60
# RSS-опрос каждые N сек (900 = 15 мин)
RSS_POLL_SEC=900
# Уровень лога news_pipeline (INFO|DEBUG)
NEWSPIPE_LOG_LEVEL=INFO

# ── Twitter/X ──────────────────────────────────────────────
TWITTER_USERNAME=
TWITTER_PASSWORD=

# ── Telegram ───────────────────────────────────────────────
# ВАЖНО: старый токен из monitor.log скомпрометирован — отзови через @BotFather и впиши новый.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=                 # лента для контента (real-time алерты)
TELEGRAM_REPORT_CHAT_ID=          # куда слать дневной дайджест (пусто = тот же чат)

# @gdenigi_bot — WP4.7 SPEC_alpha_engine_wp4_continuous_cycle.md, ОТДЕЛЬНЫЙ
# бот/канал от TELEGRAM_* выше (прогнозы агента, не операционные алерты).
# Токен создаёт Георгий через @BotFather — пусто пока не заведён.
GDENIGI_BOT_TOKEN=
GDENIGI_CHAT_ID=

# ── Поведение ──────────────────────────────────────────────
HEADLESS=false                    # true для сервера без экрана (после первого логина)
CHECK_INTERVAL_MINUTES=20
TRANSLATE=true

# ── Пороги (тюнинг под себя) ───────────────────────────────
ALERT_MIN_IMPORTANCE=0.55         # ниже — не алертим в Telegram
ALERT_MIN_ENGAGEMENT=2000
ALERT_MIN_GROWTH=1500
STORE_MIN_ECON_RELEVANCE=0.25     # ниже — вообще не пишем в БД (анти-шум)
RSS_TREND_WINDOW_HOURS=24
